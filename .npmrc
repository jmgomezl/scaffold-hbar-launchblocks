# npm workspace installs read only the root .npmrc, so the per-package
# setting in packages/hardhat/.npmrc never applies to `npm install` here.
# The Hardhat toolchain has peer ranges that npm refuses but yarn tolerates
# (hardhat-deploy-ethers wants hardhat-deploy ^0.12 against 1.x, and
# hardhat-verify's newer lines want hardhat ^2.24). Keep npm behaving like
# yarn so this template installs with either package manager.
legacy-peer-deps=true
