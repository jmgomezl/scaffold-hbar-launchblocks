{
  "name": "@sh/launchblocks",
  "version": "0.1.0",
  "private": true,
  "description": "LaunchBlocks core: flow schema, step registry, runner and codegen for Hedera token launches",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./editor": "./src/editor/index.ts",
    "./browser": "./src/browser.ts"
  },
  "sideEffects": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "docs": "tsx scripts/docs.ts",
    "docs:check": "tsx scripts/docs.ts --check",
    "doctor": "tsx scripts/doctor.ts",
    "format": "prettier --write './**/*.ts'",
    "harness-recipe": "tsx scripts/harness-recipe.ts",
    "lint": "eslint --max-warnings=0",
    "run-flow": "tsx scripts/run-flow.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.88.0",
    "dotenv": "~16.4.5",
    "viem": "2.39.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^18.19.50",
    "@typescript-eslint/eslint-plugin": "~8.27.0",
    "@typescript-eslint/parser": "~8.27.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "~9.23.0",
    "eslint-config-prettier": "~10.1.1",
    "eslint-plugin-prettier": "~5.2.4",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0",
    "yaml": "^2.8.2"
  }
}
