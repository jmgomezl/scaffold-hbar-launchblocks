# ── Scaffold-HBAR frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# ── LaunchBlocks operator (server-side only; never prefixed NEXT_PUBLIC_) ─────
# Flows run from API routes signed by this account. Create a testnet account and
# fund it at https://portal.hedera.com/faucet, then paste the id and private key.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=
# Only for raw hex keys (DER keys from the Portal are self-describing): ed25519 | ecdsa
HEDERA_OPERATOR_KEY_TYPE=
# Optional mirror node override (defaults per network)
HEDERA_MIRROR_URL=

# ── Pyth (optional, server-side) ─────────────────────────────────────────────
# A Hermes API key from Pyth Terminal. With it, "Price in USD with Pyth" posts a
# fresh HBAR/USD update to Pyth's contract on Hedera before reading it; without
# it, the step uses the price already on-chain. As of 2026-09-24 Pyth's Hedera
# contracts refuse fresh updates (InvalidWormholeVaa), so leave this unset.
PYTH_API_KEY=
# Optional: a Hermes provider other than Pyth's own (https:// only)
PYTH_HERMES_URL=

# ── LaunchBlocks run guards (server-side) ────────────────────────────────────
# Mainnet flows are refused unless this is exactly "true"
LAUNCHBLOCKS_ALLOW_MAINNET=false
# If set, POST /api/launchblocks/flows/run requires header x-launchblocks-token: <value>
LAUNCHBLOCKS_RUN_TOKEN=
# Per-client run limit for the public demo (0 disables)
LAUNCHBLOCKS_RUNS_PER_HOUR=20
# true for a public demo whose operator pays for anonymous visitors: value only
# goes to tokens and contracts the run creates, capped per step and per hour
LAUNCHBLOCKS_PUBLIC_DEMO=false
LAUNCHBLOCKS_PUBLIC_HBAR_PER_HOUR=400
LAUNCHBLOCKS_PUBLIC_MAX_HBAR_PER_STEP=25
